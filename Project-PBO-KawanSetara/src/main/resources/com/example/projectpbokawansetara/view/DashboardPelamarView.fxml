<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" style="-fx-background-color: white;" stylesheets="@../../../../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectpbokawansetara.controller.DashboardPelamarController">
    <left>
        <VBox minWidth="232.0" prefWidth="232.0" spacing="4.0" style="-fx-background-color: #F8FAFC; -fx-border-color: transparent #EAECF0 transparent transparent;">
            <padding>
                <Insets bottom="16.0" left="10.0" right="10.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <VBox.margin>
                        <Insets bottom="16.0" left="8.0" />
                    </VBox.margin>
                    <children>
                        <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../../images/logo.png" />
                            </image>
                        </ImageView>
                        <Label style="-fx-font-size: 17px;" styleClass="h2" text="KawanSetara" />
                    </children>
                </HBox>
                <ToggleButton fx:id="berandaMenu" alignment="CENTER_LEFT" graphicTextGap="12.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="40.0" selected="true" style="-fx-background-color: #DCE9F5; -fx-text-fill: #1F4E8C; -fx-font-size: 14px; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 0 12;" text="Beranda">
                    <graphic>
                        <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../../images/house.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <toggleGroup>
                        <ToggleGroup fx:id="menuGroup" />
                    </toggleGroup>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </ToggleButton>
                <ToggleButton fx:id="cariLowonganMenu" alignment="CENTER_LEFT" graphicTextGap="12.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: #344054; -fx-font-size: 14px; -fx-background-radius: 8; -fx-padding: 0 12;" text="Cari lowongan" toggleGroup="$menuGroup">
                    <graphic>
                        <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../../images/search.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </ToggleButton>
                <ToggleButton fx:id="riwayatMenu" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="40.0" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-padding: 0 12;" toggleGroup="$menuGroup">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" prefWidth="188.0" spacing="12.0">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../images/Riwayat.png" />
                                    </image>
                                </ImageView>
                                <Label style="-fx-text-fill: #344054; -fx-font-size: 14px;" text="Riwayat lamaran" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="jumlahRiwayatLabel" style="-fx-text-fill: #667085; -fx-font-size: 12px;" />
                            </children>
                        </HBox>
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </ToggleButton>
                <ToggleButton fx:id="checklistMenu" alignment="CENTER_LEFT" graphicTextGap="12.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: #344054; -fx-font-size: 14px; -fx-background-radius: 8; -fx-padding: 0 12;" text="Checklist minat &amp; bakat" toggleGroup="$menuGroup">
                    <graphic>
                        <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../../images/list-checks.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </ToggleButton>
                <Region VBox.vgrow="ALWAYS" />
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #EAECF0 transparent transparent transparent;">
                    <padding>
                        <Insets left="6.0" top="14.0" />
                    </padding>
                    <children>
                        <ImageView fx:id="avatarImage" fitHeight="34.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true" />
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="namaUserLabel" style="-fx-text-fill: #101828; -fx-font-size: 14px; -fx-font-weight: 600;" />
                                <Label fx:id="emailUserLabel" style="-fx-text-fill: #667085; -fx-font-size: 12px;" />
                            </children>
                        </VBox>
                        <Button fx:id="keluarButton" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-padding: 4;">
                            <graphic>
                                <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../images/log-out.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </left>
    <center>
        <VBox style="-fx-background-color: white;">
            <children>
                <HBox alignment="CENTER_LEFT" minHeight="56.0" prefHeight="56.0" style="-fx-background-color: white; -fx-border-color: transparent transparent #EAECF0 transparent;">
                    <padding>
                        <Insets left="24.0" right="24.0" />
                    </padding>
                    <children>
                        <Label style="-fx-text-fill: #101828; -fx-font-size: 13px;" text="Beranda" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER_LEFT" maxHeight="30.0" minHeight="30.0" prefHeight="30.0" prefWidth="280.0" spacing="8.0" style="-fx-background-color: white; -fx-border-color: #D0D5DD; -fx-background-radius: 8; -fx-border-radius: 8;">
                            <padding>
                                <Insets left="12.0" right="12.0" />
                            </padding>
                            <children>
                                <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../images/icon_search.png" />
                                    </image>
                                </ImageView>
                                <TextField fx:id="cariField" maxHeight="26.0" minHeight="26.0" prefHeight="26.0" promptText="Cari lowongan atau perusahaan" style="-fx-background-color: transparent; -fx-font-size: 12px; -fx-padding: 0; -fx-prompt-text-fill: #98A2B3;" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
                <ScrollPane fitToWidth="true" style="-fx-background-color: white; -fx-background: white; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox style="-fx-background-color: white;">
                            <padding>
                                <Insets bottom="32.0" left="32.0" right="32.0" top="28.0" />
                            </padding>
                            <children>
                                <Label fx:id="sapaanLabel" style="-fx-font-size: 24px; -fx-text-fill: #101828;" styleClass="h2" text="Selamat pagi" />
                                <Label fx:id="ringkasanLabel" style="-fx-font-size: 14px;" styleClass="body">
                                    <VBox.margin>
                                        <Insets top="4.0" />
                                    </VBox.margin>
                                </Label>
                                <HBox spacing="24.0">
                                    <VBox.margin>
                                        <Insets top="24.0" />
                                    </VBox.margin>
                                    <children>
                                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label style="-fx-text-fill: #101828; -fx-font-size: 15px; -fx-font-weight: 600;" text="Rekomendasi untukmu" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Hyperlink fx:id="lihatSemuaLink" style="-fx-text-fill: #1F4E8C; -fx-font-size: 13px; -fx-border-color: transparent; -fx-padding: 0;" text="Lihat semua" />
                                                    </children>
                                                </HBox>
                                                <VBox style="-fx-background-color: white; -fx-border-color: #EAECF0; -fx-background-radius: 10; -fx-border-radius: 10;">
                                                    <children>
                                                        <VBox fx:id="rekomendasiBox" />
                                                        <Label fx:id="rekomendasiKosongLabel" managed="false" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #667085; -fx-font-size: 14px; -fx-alignment: center; -fx-padding: 32;" text="Belum ada rekomendasi" visible="false" />
                                                    </children>
                                                </VBox>
                                                <Label style="-fx-text-fill: #98A2B3; -fx-font-size: 12px;" text="Diurutkan berdasarkan jumlah keahlian di checklist yang sesuai dengan lowongan." />
                                            </children>
                                        </VBox>
                                        <VBox minWidth="300.0" prefWidth="300.0" spacing="10.0">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label style="-fx-text-fill: #101828; -fx-font-size: 15px; -fx-font-weight: 600;" text="Lamaran terakhir" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Hyperlink fx:id="lihatRiwayatLink" style="-fx-text-fill: #1F4E8C; -fx-font-size: 13px; -fx-border-color: transparent; -fx-padding: 0;" text="Riwayat" />
                                                    </children>
                                                </HBox>
                                                <VBox style="-fx-background-color: white; -fx-border-color: #EAECF0; -fx-background-radius: 10; -fx-border-radius: 10;">
                                                    <children>
                                                        <VBox fx:id="lamaranTerakhirBox" />
                                                        <Label fx:id="lamaranKosongLabel" managed="false" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #667085; -fx-font-size: 13px; -fx-alignment: center; -fx-padding: 24;" text="Belum ada lamaran" visible="false" />
                                                    </children>
                                                </VBox>
                                                <VBox spacing="8.0" style="-fx-background-color: white; -fx-border-color: #EAECF0; -fx-background-radius: 10; -fx-border-radius: 10;">
                                                    <VBox.margin>
                                                        <Insets top="14.0" />
                                                    </VBox.margin>
                                                    <padding>
                                                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                                    </padding>
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                                                    <image>
                                                                        <Image url="@../../../../images/list-checks.png" />
                                                                    </image>
                                                                </ImageView>
                                                                <Label style="-fx-text-fill: #101828; -fx-font-size: 14px; -fx-font-weight: 600;" text="Checklist minat &amp; bakat" />
                                                            </children>
                                                        </HBox>
                                                        <Label fx:id="checklistInfoLabel" style="-fx-text-fill: #475467; -fx-font-size: 13px; -fx-line-spacing: 3;" wrapText="true" />
                                                        <Hyperlink fx:id="perbaruiChecklistLink" style="-fx-text-fill: #1F4E8C; -fx-font-size: 13px; -fx-border-color: transparent; -fx-padding: 0;" text="Perbarui checklist" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </center>
</BorderPane>