<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="1000.0" style="-fx-background-color: white;" stylesheets="@../../../../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectpbokawansetara.controller.KelolaChecklistController">
    <left>
        <VBox minWidth="232.0" prefWidth="232.0" spacing="2.0" style="-fx-background-color: #F8FAFC; -fx-border-color: transparent #EAECF0 transparent transparent;">
            <padding>
                <Insets bottom="16.0" left="10.0" right="10.0" top="20.0"/>
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <VBox.margin>
                        <Insets bottom="12.0" left="8.0"/>
                    </VBox.margin>
                    <children>
                        <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../../images/logo.png"/>
                            </image>
                        </ImageView>
                        <Label style="-fx-font-size: 15px;" styleClass="h2" text="KawanSetara"/>
                    </children>
                </HBox>
                <Label style="-fx-text-fill: #98A2B3; -fx-font-size: 11px; -fx-font-weight: 600; -fx-padding: 8 10 4 10;" text="UTAMA"/>
                <ToggleButton fx:id="dashboardMenu" alignment="CENTER_LEFT" graphicTextGap="12.0" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="30.0" style="-fx-background-color: transparent; -fx-text-fill: #344054; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 0 12;" text="Dashboard">
                    <graphic>
                        <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../../images/house.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                    <toggleGroup>
                        <ToggleGroup fx:id="adminMenuGroup"/>
                    </toggleGroup>
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </ToggleButton>
                <Label style="-fx-text-fill: #98A2B3; -fx-font-size: 11px; -fx-font-weight: 600; -fx-padding: 12 10 4 10;" text="LOWONGAN"/>
                <ToggleButton fx:id="lowonganMenu" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="30.0" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-padding: 0 12;" toggleGroup="$adminMenuGroup">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" prefWidth="188.0" spacing="12.0">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../images/briefcase.png"/>
                                    </image>
                                </ImageView>
                                <Label style="-fx-text-fill: #344054; -fx-font-size: 13px;" text="Lowongan"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="jumlahLowonganMenuLabel" style="-fx-text-fill: #667085; -fx-font-size: 12px;" text="128"/>
                            </children>
                        </HBox>
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </ToggleButton>
                <ToggleButton fx:id="perusahaanMenu" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="30.0" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-padding: 0 12;" toggleGroup="$adminMenuGroup">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" prefWidth="188.0" spacing="12.0">
                            <children>
                                <Label alignment="CENTER" minWidth="18.0" prefWidth="18.0" style="-fx-text-fill: #667085; -fx-font-size: 13px;" text="▦"/>
                                <Label style="-fx-text-fill: #344054; -fx-font-size: 13px;" text="Perusahaan"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="jumlahPerusahaanMenuLabel" style="-fx-text-fill: #667085; -fx-font-size: 12px;" text="36"/>
                            </children>
                        </HBox>
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </ToggleButton>
                <Label style="-fx-text-fill: #98A2B3; -fx-font-size: 11px; -fx-font-weight: 600; -fx-padding: 12 10 4 10;" text="DATA MASTER"/>
                <ToggleButton fx:id="itemChecklistMenu" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="30.0" selected="true" style="-fx-background-color: #DCE9F5; -fx-background-radius: 8; -fx-padding: 0 12;" toggleGroup="$adminMenuGroup">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" prefWidth="188.0" spacing="12.0">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../images/list-checks.png"/>
                                    </image>
                                </ImageView>
                                <Label style="-fx-text-fill: #1F4E8C; -fx-font-size: 13px; -fx-font-weight: 600;" text="Item checklist"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="jumlahChecklistMenuLabel" style="-fx-text-fill: #1F4E8C; -fx-font-size: 12px;" text="24"/>
                            </children>
                        </HBox>
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </ToggleButton>
                <ToggleButton fx:id="jenisDisabilitasMenu" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="30.0" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-padding: 0 12;" toggleGroup="$adminMenuGroup">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" prefWidth="188.0" spacing="12.0">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../images/accessibility.png"/>
                                    </image>
                                </ImageView>
                                <Label style="-fx-text-fill: #344054; -fx-font-size: 13px;" text="Jenis disabilitas"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="jumlahDisabilitasMenuLabel" style="-fx-text-fill: #667085; -fx-font-size: 12px;" text="5"/>
                            </children>
                        </HBox>
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </ToggleButton>
                <Label style="-fx-text-fill: #98A2B3; -fx-font-size: 11px; -fx-font-weight: 600; -fx-padding: 12 10 4 10;" text="PENGATURAN"/>
                <ToggleButton fx:id="akunAdminMenu" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="30.0" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-padding: 0 12;" toggleGroup="$adminMenuGroup">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" prefWidth="188.0" spacing="12.0">
                            <children>
                                <Label alignment="CENTER" minWidth="18.0" prefWidth="18.0" style="-fx-text-fill: #667085; -fx-font-size: 13px;" text="⛉"/>
                                <Label style="-fx-text-fill: #344054; -fx-font-size: 13px;" text="Akun admin"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="jumlahAdminMenuLabel" style="-fx-text-fill: #667085; -fx-font-size: 12px;" text="4"/>
                            </children>
                        </HBox>
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </ToggleButton>
                <Region VBox.vgrow="ALWAYS"/>
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #EAECF0 transparent transparent transparent;">
                    <padding>
                        <Insets left="6.0" top="14.0"/>
                    </padding>
                    <children>
                        <ImageView fx:id="avatarImage" fitHeight="34.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../../images/avatar.jpeg"/>
                            </image>
                        </ImageView>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="namaUserLabel" style="-fx-text-fill: #101828; -fx-font-size: 13px; -fx-font-weight: 600;" text="Made Satya"/>
                                <Label fx:id="peranUserLabel" style="-fx-text-fill: #667085; -fx-font-size: 12px;" text="Admin"/>
                            </children>
                        </VBox>
                        <Button fx:id="keluarButton" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-padding: 4;">
                            <graphic>
                                <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../images/log-out.png"/>
                                    </image>
                                </ImageView>
                            </graphic>
                            <cursor>
                                <Cursor fx:constant="HAND"/>
                            </cursor>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </left>
    <center>
        <VBox style="-fx-background-color: white;">
            <children>
                <HBox alignment="CENTER_LEFT" minHeight="48.0" prefHeight="48.0" spacing="6.0" style="-fx-background-color: white; -fx-border-color: transparent transparent #EAECF0 transparent;">
                    <padding>
                        <Insets left="24.0" right="24.0"/>
                    </padding>
                    <children>
                        <Label style="-fx-text-fill: #667085; -fx-font-size: 13px;" text="Data master  /"/>
                        <Label style="-fx-text-fill: #101828; -fx-font-size: 13px; -fx-font-weight: 600;" text="Item checklist"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox alignment="CENTER_LEFT" maxHeight="30.0" minHeight="30.0" prefHeight="30.0" prefWidth="280.0" spacing="8.0" style="-fx-background-color: white; -fx-border-color: #D0D5DD; -fx-background-radius: 8; -fx-border-radius: 8;">
                            <padding>
                                <Insets left="12.0" right="12.0"/>
                            </padding>
                            <children>
                                <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../images/icon_search.png"/>
                                    </image>
                                </ImageView>
                                <TextField fx:id="cariField" maxHeight="26.0" minHeight="26.0" prefHeight="26.0" promptText="Cari di panel admin" style="-fx-background-color: transparent; -fx-font-size: 12px; -fx-padding: 0; -fx-prompt-text-fill: #98A2B3;" HBox.hgrow="ALWAYS"/>
                            </children>
                        </HBox>
                    </children>
                </HBox>
                <VBox spacing="10.0" style="-fx-background-color: white;" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="20.0"/>
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label styleClass="page-title" text="Item checklist minat &amp; bakat"/>
                                        <Label styleClass="body" text="Item tampil di Checklist pelamar dan dipakai untuk mencocokkan lowongan (Keahlian)."/>
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                            </children>
                        </HBox>
                        <HBox spacing="16.0" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" prefHeight="30.0" prefWidth="240.0" spacing="8.0" styleClass="input-box">
                                                    <children>
                                                        <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                                                            <image>
                                                                <Image url="@../../../../images/icon_search.png"/>
                                                            </image>
                                                        </ImageView>
                                                        <TextField fx:id="cariItemField" promptText="Cari item" HBox.hgrow="ALWAYS"/>
                                                    </children>
                                                </HBox>
                                                <ComboBox fx:id="filterKategoriComboBox" prefHeight="30.0" prefWidth="168.0" promptText="Semua kategori"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label fx:id="ringkasanLabel" styleClass="text-muted" text="24 item · 4 kategori"/>
                                            </children>
                                        </HBox>
                                        <TableView fx:id="itemTable" fixedCellSize="40.0" styleClass="admin-table" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="idColumn" prefWidth="70.0" text="ID"/>
                                                <TableColumn fx:id="kategoriColumn" prefWidth="110.0" text="Kategori"/>
                                                <TableColumn fx:id="namaColumn" prefWidth="190.0" text="Nama item"/>
                                                <TableColumn fx:id="diLowonganColumn" prefWidth="95.0" style="-fx-alignment: CENTER_RIGHT;" text="Di lowongan"/>
                                                <TableColumn fx:id="dipilihColumn" prefWidth="110.0" style="-fx-alignment: CENTER_RIGHT;" text="Dipilih pelamar"/>
                                                <TableColumn fx:id="aksiColumn" prefWidth="80.0" sortable="false"/>
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>
                                <VBox maxWidth="320.0" minWidth="320.0" prefWidth="320.0" spacing="14.0" styleClass="card">
                                    <padding>
                                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                                    </padding>
                                    <children>
                                        <Label styleClass="section-title" text="Tambah item checklist"/>
                                        <HBox fx:id="suksesBanner" managed="false" spacing="8.0" style="-fx-background-color: #ECFDF3; -fx-border-color: #ABEFC6; -fx-background-radius: 8; -fx-border-radius: 8;" visible="false">
                                            <padding>
                                                <Insets bottom="10.0" left="12.0" right="12.0" top="10.0"/>
                                            </padding>
                                            <children>
                                                <Label style="-fx-text-fill: #079455; -fx-font-weight: bold;" text="✓"/>
                                                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label fx:id="suksesBannerJudulLabel" style="-fx-text-fill: #067647; -fx-font-weight: 600;" text="“Analisis data” ditambahkan ke Teknologi" wrapText="true"/>
                                                        <Label fx:id="suksesBannerPesanLabel" style="-fx-text-fill: #079455; -fx-font-size: 12px;" text="Pelamar langsung melihatnya di checklist." wrapText="true"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                        <HBox fx:id="errorBanner" managed="false" spacing="8.0" style="-fx-background-color: #FEF3F2; -fx-border-color: #FDA29B; -fx-background-radius: 8; -fx-border-radius: 8;" visible="false">
                                            <padding>
                                                <Insets bottom="10.0" left="12.0" right="12.0" top="10.0"/>
                                            </padding>
                                            <children>
                                                <Label style="-fx-text-fill: #D92D20; -fx-font-weight: bold;" text="!"/>
                                                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label fx:id="errorBannerJudulLabel" style="-fx-text-fill: #B42318; -fx-font-weight: 600;" text="Item belum ditambahkan" wrapText="true"/>
                                                        <Label fx:id="errorBannerPesanLabel" style="-fx-text-fill: #D92D20; -fx-font-size: 12px;" text="Perbaiki isian yang ditandai merah." wrapText="true"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>
                                        <VBox spacing="6.0">
                                            <children>
                                                <Label styleClass="label-sm" text="Nama item"/>
                                                <HBox fx:id="namaItemBox" alignment="CENTER_LEFT" prefHeight="30.0" spacing="8.0" styleClass="input-box">
                                                    <children>
                                                        <TextField fx:id="namaItemField" promptText="Contoh: Fotografi produk" HBox.hgrow="ALWAYS"/>
                                                    </children>
                                                </HBox>
                                                <Label styleClass="text-muted" text="Gunakan nama keahlian yang umum dipakai di lowongan" wrapText="true"/>
                                                <Label fx:id="namaItemErrorLabel" managed="false" styleClass="error" text="Item sudah ada di kategori ini" visible="false" wrapText="true"/>
                                            </children>
                                        </VBox>
                                        <VBox spacing="6.0">
                                            <children>
                                                <Label styleClass="label-sm" text="Kategori"/>
                                                <ComboBox fx:id="kategoriComboBox" maxWidth="1.7976931348623157E308" prefHeight="30.0" promptText="Pilih kategori"/>
                                                <Label fx:id="kategoriErrorLabel" managed="false" styleClass="error" text="Kategori wajib dipilih" visible="false" wrapText="true"/>
                                            </children>
                                        </VBox>
                                        <Button fx:id="tambahButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="32.0" styleClass="btn-primary" text="+  Tambah ke checklist"/>
                                        <VBox fx:id="previewBox" managed="false" spacing="8.0" visible="false">
                                            <children>
                                                <Label styleClass="label-sm" text="Tampilan di checklist pelamar"/>
                                                <VBox spacing="8.0" style="-fx-background-color: #F9FAFB; -fx-border-color: #EAECF0; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 12;">
                                                    <children>
                                                        <Label fx:id="previewKategoriLabel" styleClass="text-muted" text="Teknologi"/>
                                                        <CheckBox fx:id="previewCheckBox" disable="true" mnemonicParsing="false" text="Analisis data"/>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>