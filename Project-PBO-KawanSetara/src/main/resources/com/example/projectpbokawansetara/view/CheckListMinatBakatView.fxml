                                                        <CheckBox fx:id="bahasaIsyaratCheckBox" mnemonicParsing="false" prefWidth="240.0" selected="true" style="-fx-text-fill: #344054; -fx-font-size: 14px;" text="Bahasa Isyarat (BISINDO)" />
                                                        <CheckBox fx:id="bahasaInggrisCheckBox" mnemonicParsing="false" prefWidth="240.0" style="-fx-text-fill: #344054; -fx-font-size: 14px;" text="Bahasa Inggris" />
