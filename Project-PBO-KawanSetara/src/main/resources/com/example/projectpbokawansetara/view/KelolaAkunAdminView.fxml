                                <Label fx:id="jumlahPerusahaanMenuLabel" style="-fx-text-fill: #667085; -fx-font-size: 12px;" text="36"/>
                            </children>
                        </HBox>
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </ToggleButton>
                <Label style="-fx-text-fill: #98A2B3; -fx-font-size: 11px; -fx-font-weight: 600; -fx-padding: 12 10 4 10;" text="DATA MASTER"/>
                <ToggleButton fx:id="itemChecklistMenu" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="30.0" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-padding: 0 12;" toggleGroup="$adminMenuGroup">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" prefWidth="188.0" spacing="12.0">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../images/list-checks.png"/>
                                    </image>
                                </ImageView>
                                <Label style="-fx-text-fill: #344054; -fx-font-size: 13px;" text="Item checklist"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="jumlahChecklistMenuLabel" style="-fx-text-fill: #667085; -fx-font-size: 12px;" text="24"/>
                            </children>
                        </HBox>
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </ToggleButton>
                <ToggleButton fx:id="jenisDisabilitasMenu" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="30.0" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-padding: 0 12;" toggleGroup="$adminMenuGroup">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" prefWidth="188.0" spacing="12.0">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../images/accessibility.png"/>
                                    </image>
                                </ImageView>
                                <Label style="-fx-text-fill: #344054; -fx-font-size: 13px;" text="Jenis disabilitas"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="jumlahDisabilitasMenuLabel" style="-fx-text-fill: #667085; -fx-font-size: 12px;" text="5"/>
                            </children>
                        </HBox>
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </ToggleButton>
                <Label style="-fx-text-fill: #98A2B3; -fx-font-size: 11px; -fx-font-weight: 600; -fx-padding: 12 10 4 10;" text="PENGATURAN"/>
                <ToggleButton fx:id="akunAdminMenu" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="30.0" selected="true" style="-fx-background-color: #DCE9F5; -fx-background-radius: 8; -fx-padding: 0 12;" toggleGroup="$adminMenuGroup">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" prefWidth="188.0" spacing="12.0">
                            <children>
                                <Label alignment="CENTER" minWidth="18.0" prefWidth="18.0" style="-fx-text-fill: #1F4E8C; -fx-font-size: 13px;" text="⛉"/>
