                    <graphic>
                        <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../../images/house.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                    <toggleGroup>
                        <ToggleGroup fx:id="adminMenuGroup"/>
                    </toggleGroup>
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </ToggleButton>
                <Label style="-fx-text-fill: #98A2B3; -fx-font-size: 11px; -fx-font-weight: 600; -fx-padding: 12 10 4 10;" text="LOWONGAN"/>
                <ToggleButton fx:id="lowonganMenu" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="30.0" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-padding: 0 12;" toggleGroup="$adminMenuGroup">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" prefWidth="188.0" spacing="12.0">
                            <children>
                                <ImageView fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../images/briefcase.png"/>
                                    </image>
                                </ImageView>
                                <Label style="-fx-text-fill: #344054; -fx-font-size: 13px;" text="Lowongan"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="jumlahLowonganMenuLabel" style="-fx-text-fill: #667085; -fx-font-size: 12px;" text="128"/>
                            </children>
                        </HBox>
                    </graphic>
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </ToggleButton>
                <ToggleButton fx:id="perusahaanMenu" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" prefHeight="30.0" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-padding: 0 12;" toggleGroup="$adminMenuGroup">
                    <graphic>
                        <HBox alignment="CENTER_LEFT" prefWidth="188.0" spacing="12.0">
                            <children>
                                <Label alignment="CENTER" minWidth="18.0" prefWidth="18.0" style="-fx-text-fill: #667085; -fx-font-size: 13px;" text="▦"/>
                                <Label style="-fx-text-fill: #344054; -fx-font-size: 13px;" text="Perusahaan"/>
