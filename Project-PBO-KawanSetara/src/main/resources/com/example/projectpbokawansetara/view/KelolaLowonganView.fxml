<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="1000.0" style="-fx-background-color: white;" stylesheets="@../../../../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectpbokawansetara.controller.KelolaLowonganController">
    <center>
        <VBox style="-fx-background-color: white;">
            <children>
                <HBox alignment="CENTER_LEFT" minHeight="48.0" prefHeight="48.0" style="-fx-background-color: white; -fx-border-color: transparent transparent #EAECF0 transparent;">
                    <padding>
                        <Insets left="24.0" right="24.0" />
                    </padding>
                    <children>
                        <Label style="-fx-text-fill: #101828; -fx-font-size: 13px;" text="Lowongan" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER_LEFT" maxHeight="30.0" minHeight="30.0" prefHeight="30.0" prefWidth="280.0" spacing="8.0" style="-fx-background-color: white; -fx-border-color: #D0D5DD; -fx-background-radius: 8; -fx-border-radius: 8;">
                            <padding>
                                <Insets left="12.0" right="12.0" />
                            </padding>
                            <children>
                                <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../images/icon_search.png" />
                                    </image>
                                </ImageView>
                                <TextField fx:id="cariField" maxHeight="26.0" minHeight="26.0" prefHeight="26.0" promptText="Cari di panel admin" style="-fx-background-color: transparent; -fx-font-size: 12px; -fx-padding: 0; -fx-prompt-text-fill: #98A2B3;" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
                <VBox spacing="10.0" style="-fx-background-color: white;" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label style="-fx-font-size: 18px; -fx-text-fill: #101828; -fx-font-weight: bold;" styleClass="h2" text="Lowongan" />
                                        <Label fx:id="ringkasanLabel" style="-fx-text-fill: #667085; -fx-font-size: 13px;" text="128 lowongan dari 36 perusahaan mitra" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="tambahLowonganButton" onAction="#handleTambah" mnemonicParsing="false" prefHeight="32.0" style="-fx-background-color: #1F4E8C; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 600; -fx-padding: 0 18;" text="+  Tambah lowongan">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </Button>
                            </children>
                        </HBox>
                        <HBox spacing="4.0" style="-fx-border-color: transparent transparent #EAECF0 transparent;">
                            <children>
                                <ToggleButton fx:id="semuaTab" onAction="#handleFilter" mnemonicParsing="false" selected="true" style="-fx-background-color: transparent; -fx-border-color: transparent transparent #1F4E8C transparent; -fx-border-width: 0 0 2 0; -fx-text-fill: #1F4E8C; -fx-font-size: 13px; -fx-font-weight: 600; -fx-padding: 6 4 10 4;" text="Semua 128">
                                    <toggleGroup>
                                        <ToggleGroup fx:id="statusTabGroup" />
                                    </toggleGroup>
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </ToggleButton>
                                <ToggleButton fx:id="tersediaTab" onAction="#handleFilter" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #475467; -fx-font-size: 13px; -fx-padding: 6 12 10 12;" text="Tersedia 112" toggleGroup="$statusTabGroup">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </ToggleButton>
                                <ToggleButton fx:id="tidakTersediaTab" onAction="#handleFilter" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #475467; -fx-font-size: 13px; -fx-padding: 6 12 10 12;" text="Tidak tersedia 16" toggleGroup="$statusTabGroup">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </ToggleButton>
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" prefHeight="30.0" prefWidth="220.0" spacing="8.0" style="-fx-background-color: white; -fx-border-color: #D0D5DD; -fx-background-radius: 8; -fx-border-radius: 8;">
                                    <padding>
                                        <Insets left="12.0" right="12.0" />
                                    </padding>
                                    <children>
                                        <ImageView fitHeight="16.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@../../../../images/icon_search.png" />
                                            </image>
                                        </ImageView>
                                        <TextField fx:id="cariPekerjaanField" promptText="Cari nama pekerjaan" style="-fx-background-color: transparent; -fx-font-size: 13px; -fx-padding: 0; -fx-prompt-text-fill: #98A2B3;" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                                <ComboBox fx:id="perusahaanComboBox" onAction="#handleFilter" prefHeight="30.0" prefWidth="145.0" promptText="Semua perusahaan" style="-fx-background-color: white; -fx-border-color: #D0D5DD; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-size: 13px;" />
                                <ComboBox fx:id="jenisComboBox" onAction="#handleFilter" prefHeight="30.0" prefWidth="110.0" promptText="Semua jenis" style="-fx-background-color: white; -fx-border-color: #D0D5DD; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-size: 13px;" />
                                <ComboBox fx:id="lokasiComboBox" onAction="#handleFilter" prefHeight="30.0" prefWidth="120.0" promptText="Semua lokasi" style="-fx-background-color: white; -fx-border-color: #D0D5DD; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-size: 13px;" />
                            </children>
                        </HBox>
                        <VBox style="-fx-background-color: white; -fx-border-color: #EAECF0; -fx-background-radius: 8; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                            <children>
                                <TableView fx:id="lowonganTable" fixedCellSize="40.0" styleClass="admin-table" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="posisiColumn" prefWidth="200.0" text="Posisi" />
                                        <TableColumn fx:id="perusahaanColumn" prefWidth="140.0" text="Perusahaan" />
                                        <TableColumn fx:id="lokasiColumn" prefWidth="95.0" text="Lokasi" />
                                        <TableColumn fx:id="jenisColumn" prefWidth="90.0" text="Jenis" />
                                        <TableColumn fx:id="gajiColumn" prefWidth="110.0" style="-fx-alignment: CENTER_RIGHT;" text="Gaji / bulan" />
                                        <TableColumn fx:id="pelamarColumn" prefWidth="80.0" style="-fx-alignment: CENTER_RIGHT;" text="Pelamar" />
                                        <TableColumn fx:id="statusColumn" prefWidth="110.0" text="Status" />
                                        <TableColumn fx:id="aksiColumn" prefWidth="80.0" sortable="false" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <placeholder>
                                        <Label style="-fx-text-fill: #667085; -fx-font-size: 13px;" text="Belum ada lowongan" />
                                    </placeholder>
                                </TableView>
                                <HBox alignment="CENTER_LEFT" prefHeight="52.0" spacing="8.0" style="-fx-border-color: #EAECF0 transparent transparent transparent;">
                                    <padding>
                                        <Insets left="14.0" right="12.0" />
                                    </padding>
                                    <children>
                                        <Label fx:id="infoTampilLabel" style="-fx-text-fill: #475467; -fx-font-size: 12px;" text="Menampilkan 1–8 dari 128" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="infoHalamanLabel" style="-fx-text-fill: #475467; -fx-font-size: 12px;" text="Halaman 1 dari 16" />
                                        <Button fx:id="sebelumnyaButton" onAction="#handleSebelumnya" mnemonicParsing="false" prefHeight="32.0" prefWidth="40.0" style="-fx-background-color: white; -fx-border-color: #D0D5DD; -fx-background-radius: 8; -fx-border-radius: 8; -fx-text-fill: #344054; -fx-font-size: 13px;" text="‹">
                                            <cursor>
                                                <Cursor fx:constant="HAND" />
                                            </cursor>
                                        </Button>
                                        <Button fx:id="berikutnyaButton" onAction="#handleBerikutnya" mnemonicParsing="false" prefHeight="32.0" prefWidth="40.0" style="-fx-background-color: white; -fx-border-color: #D0D5DD; -fx-background-radius: 8; -fx-border-radius: 8; -fx-text-fill: #344054; -fx-font-size: 13px;" text="›">
                                            <cursor>
                                                <Cursor fx:constant="HAND" />
                                            </cursor>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>