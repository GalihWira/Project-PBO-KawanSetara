                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Button fx:id="hapusButton" graphicTextGap="6.0" minWidth="-Infinity" mnemonicParsing="false" prefHeight="36.0" style="-fx-background-color: transparent; -fx-text-fill: #D92D20; -fx-font-weight: 600; -fx-padding: 0 6;" text="Hapus">
