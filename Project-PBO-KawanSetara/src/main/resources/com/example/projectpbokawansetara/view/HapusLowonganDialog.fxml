<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="440.0" spacing="20.0" styleClass="card" stylesheets="@../../../../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectpbokawansetara.controller.HapusLowonganController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox spacing="14.0">
            <children>
                <StackPane maxHeight="32.0" maxWidth="32.0" minHeight="32.0" minWidth="32.0" prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: #FEE4E2; -fx-background-radius: 16;">
                    <children>
                        <Label style="-fx-text-fill: #D92D20; -fx-font-size: 14px;" text="⚠" />
                    </children>
                </StackPane>
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="judulLabel" style="-fx-font-size: 16px;" styleClass="section-title" text="Hapus lowongan “Customer Service Chat”?" wrapText="true" />
                        <Label fx:id="pesanLabel" style="-fx-font-size: 13px; -fx-line-spacing: 3;" styleClass="body" text="31 lamaran yang terkait dengan lowongan ini juga akan terhapus. Tindakan ini tidak bisa dibatalkan." wrapText="true" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <HBox alignment="CENTER_RIGHT" spacing="8.0">
            <children>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="batalButton" mnemonicParsing="false" prefHeight="36.0" styleClass="btn-secondary" text="Batal" />
                <Button fx:id="hapusButton" mnemonicParsing="false" prefHeight="36.0" styleClass="btn-danger" text="Hapus lowongan" />
            </children>
        </HBox>
    </children>
</VBox>