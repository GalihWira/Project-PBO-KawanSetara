<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="1000.0" style="-fx-background-color: white;" stylesheets="@../../../../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectpbokawansetara.controller.KelolaAkunAdminController">
    <center>
        <VBox style="-fx-background-color: white;">
            <children>
                <HBox alignment="CENTER_LEFT" minHeight="48.0" prefHeight="48.0" spacing="6.0" style="-fx-background-color: white; -fx-border-color: transparent transparent #EAECF0 transparent;">
                    <padding>
                        <Insets left="24.0" right="24.0" />
                    </padding>
                    <children>
                        <Label style="-fx-text-fill: #667085; -fx-font-size: 13px;" text="Pengaturan  /" />
                        <Label style="-fx-text-fill: #101828; -fx-font-size: 13px; -fx-font-weight: 600;" text="Akun admin" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER_LEFT" maxHeight="30.0" minHeight="30.0" prefHeight="30.0" prefWidth="280.0" spacing="8.0" style="-fx-background-color: white; -fx-border-color: #D0D5DD; -fx-background-radius: 8; -fx-border-radius: 8;">
                            <padding>
                                <Insets left="12.0" right="12.0" />
                            </padding>
                            <children>
                                <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../images/icon_search.png" />
                                    </image>
                                </ImageView>
                                <TextField fx:id="cariField" maxHeight="26.0" minHeight="26.0" prefHeight="26.0" promptText="Cari di panel admin" style="-fx-background-color: transparent; -fx-font-size: 12px; -fx-padding: 0; -fx-prompt-text-fill: #98A2B3;" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
                <VBox spacing="12.0" style="-fx-background-color: white;" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
                    </padding>
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="page-title" text="Akun admin" />
                                <Label styleClass="body" text="Daftar akun admin. Akun admin baru dibuat langsung lewat database." />
                            </children>
                        </VBox>
                        <TableView fx:id="adminTable" fixedCellSize="40.0" prefHeight="245.0" styleClass="admin-table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="namaColumn" prefWidth="300.0" text="Nama" />
                                <TableColumn fx:id="emailColumn" prefWidth="360.0" text="Email" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <placeholder>
                                <Label style="-fx-text-fill: #667085; -fx-font-size: 13px;" text="Belum ada akun admin" />
                            </placeholder>
                        </TableView>
                        <VBox styleClass="card">
                            <children>
                                <Label styleClass="section-title" text="Peran akun">
                                    <padding>
                                        <Insets bottom="12.0" left="16.0" right="16.0" top="14.0" />
                                    </padding>
                                </Label>
                                <HBox style="-fx-background-color: #F9FAFB; -fx-border-color: #EAECF0 transparent #EAECF0 transparent; -fx-padding: 10 16;">
                                    <children>
                                        <Label prefWidth="100.0" styleClass="text-muted" text="Peran" />
                                        <Label maxWidth="1.7976931348623157E308" styleClass="text-muted" text="Cara akun dibuat" HBox.hgrow="ALWAYS" />
                                        <Label prefWidth="160.0" styleClass="text-muted" text="Setelah masuk" />
                                    </children>
                                </HBox>
                                <HBox style="-fx-border-color: transparent transparent #EAECF0 transparent; -fx-padding: 14 16;">
                                    <children>
                                        <Label prefWidth="100.0" style="-fx-text-fill: #101828;" text="Admin" />
                                        <Label maxWidth="1.7976931348623157E308" style="-fx-text-fill: #344054;" text="Dibuat lewat database" HBox.hgrow="ALWAYS" />
                                        <Label prefWidth="160.0" style="-fx-text-fill: #344054;" text="Dashboard admin" />
                                    </children>
                                </HBox>
                                <HBox style="-fx-padding: 14 16;">
                                    <children>
                                        <Label prefWidth="100.0" style="-fx-text-fill: #101828;" text="Pelamar" />
                                        <Label maxWidth="1.7976931348623157E308" style="-fx-text-fill: #344054;" text="Daftar sendiri (email, Google, atau Facebook)" HBox.hgrow="ALWAYS" />
                                        <Label prefWidth="160.0" style="-fx-text-fill: #344054;" text="Beranda pelamar" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>