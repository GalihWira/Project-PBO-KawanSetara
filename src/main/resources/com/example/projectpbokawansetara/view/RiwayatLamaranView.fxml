<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="1000.0" style="-fx-background-color: white;" stylesheets="@../../../../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectpbokawansetara.controller.RiwayatLamaranController">
   <center>
      <VBox style="-fx-background-color: white;">
         <children>
            <HBox alignment="CENTER_LEFT" minHeight="48.0" prefHeight="48.0" style="-fx-background-color: white; -fx-border-color: transparent transparent #EAECF0 transparent;">
               <padding>
                  <Insets left="24.0" right="24.0" />
               </padding>
               <children>
                  <Label style="-fx-text-fill: #101828; -fx-font-size: 13px;" text="Riwayat lamaran" />
               </children>
            </HBox>
            <ScrollPane fitToWidth="true" style="-fx-background-color: white; -fx-background: white; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox style="-fx-background-color: white;">
                     <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
                     </padding>
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #101828; -fx-font-weight: bold;" text="Riwayat lamaran" />
                        <Label style="-fx-font-size: 12px;" styleClass="body" text="Status diperbarui oleh perusahaan melalui admin KawanSetara.">
                           <VBox.margin>
                              <Insets top="4.0" />
                           </VBox.margin>
                        </Label>
                        <HBox spacing="12.0" style="-fx-border-color: transparent transparent #EAECF0 transparent;">
                           <VBox.margin>
                              <Insets top="16.0" />
                           </VBox.margin>
                           <children>
                              <ToggleButton fx:id="semuaTab" onAction="#handleFilter" mnemonicParsing="false" selected="true" style="-fx-background-color: transparent; -fx-text-fill: #1F4E8C; -fx-font-size: 13px; -fx-font-weight: 600; -fx-padding: 0 2 8 2; -fx-border-color: transparent transparent #1F4E8C transparent; -fx-border-width: 0 0 2 0;" text="Semua">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="statusGroup" />
                                 </toggleGroup>
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor>
                              </ToggleButton>
                              <ToggleButton fx:id="diprosesTab" onAction="#handleFilter" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #344054; -fx-font-size: 13px; -fx-padding: 0 2 8 2;" text="Diproses" toggleGroup="$statusGroup">
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor>
                              </ToggleButton>
                              <ToggleButton fx:id="ditinjauTab" onAction="#handleFilter" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #344054; -fx-font-size: 13px; -fx-padding: 0 2 8 2;" text="Ditinjau" toggleGroup="$statusGroup">
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor>
                              </ToggleButton>
                              <ToggleButton fx:id="diterimaTab" onAction="#handleFilter" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #344054; -fx-font-size: 13px; -fx-padding: 0 2 8 2;" text="Diterima" toggleGroup="$statusGroup">
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor>
                              </ToggleButton>
                              <ToggleButton fx:id="ditolakTab" onAction="#handleFilter" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #344054; -fx-font-size: 13px; -fx-padding: 0 2 8 2;" text="Ditolak" toggleGroup="$statusGroup">
                                 <cursor>
                                    <Cursor fx:constant="HAND" />
                                 </cursor>
                              </ToggleButton>
                           </children>
                        </HBox>
                        <VBox style="-fx-background-color: white; -fx-border-color: #EAECF0; -fx-background-radius: 8; -fx-border-radius: 8;">
                           <VBox.margin>
                              <Insets top="16.0" />
                           </VBox.margin>
                           <children>
                              <HBox alignment="CENTER_LEFT" prefHeight="32.0" style="-fx-background-color: #F9FAFB; -fx-background-radius: 8 8 0 0; -fx-border-color: transparent transparent #EAECF0 transparent;">
                                 <padding>
                                    <Insets left="12.0" right="12.0" />
                                 </padding>
                                 <children>
                                    <Label prefWidth="220.0" style="-fx-text-fill: #475467; -fx-font-size: 11px;" text="Posisi" />
                                    <Label prefWidth="90.0" style="-fx-text-fill: #475467; -fx-font-size: 11px;" text="Lokasi" />
                                    <Label prefWidth="80.0" style="-fx-text-fill: #475467; -fx-font-size: 11px;" text="Jenis" />
                                    <Label prefWidth="105.0" style="-fx-text-fill: #475467; -fx-font-size: 11px;" text="Tanggal lamar" />
                                    <Label prefWidth="85.0" style="-fx-text-fill: #475467; -fx-font-size: 11px;" text="Status" />
                                    <Region HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                              <VBox fx:id="daftarLamaranBox" />
                              <Label fx:id="kosongLabel" managed="false" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #667085; -fx-font-size: 12px; -fx-alignment: center; -fx-padding: 32;" text="Belum ada lamaran" visible="false" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </center>
</BorderPane>