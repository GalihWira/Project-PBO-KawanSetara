<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="1000.0" style="-fx-background-color: white;" stylesheets="@../../../../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projectpbokawansetara.controller.KelolaLamaranController">
    <center>
        <VBox style="-fx-background-color: white;">
            <children>
                <HBox alignment="CENTER_LEFT" minHeight="48.0" prefHeight="48.0" spacing="6.0" style="-fx-background-color: white; -fx-border-color: transparent transparent #EAECF0 transparent;">
                    <padding>
                        <Insets left="24.0" right="24.0" />
                    </padding>
                    <children>
                        <Label style="-fx-text-fill: #667085; -fx-font-size: 13px;" text="Lowongan  /" />
                        <Label style="-fx-text-fill: #101828; -fx-font-size: 13px; -fx-font-weight: 600;" text="Lamaran masuk" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER_LEFT" maxHeight="30.0" minHeight="30.0" prefHeight="30.0" prefWidth="280.0" spacing="8.0" style="-fx-background-color: white; -fx-border-color: #D0D5DD; -fx-background-radius: 8; -fx-border-radius: 8;">
                            <padding>
                                <Insets left="12.0" right="12.0" />
                            </padding>
                            <children>
                                <ImageView fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../images/icon_search.png" />
                                    </image>
                                </ImageView>
                                <TextField fx:id="cariField" maxHeight="26.0" minHeight="26.0" prefHeight="26.0" promptText="Cari nama pelamar atau posisi" style="-fx-background-color: transparent; -fx-font-size: 13px; -fx-padding: 0; -fx-prompt-text-fill: #98A2B3;" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
                <VBox spacing="10.0" style="-fx-background-color: white;" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
                    </padding>
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="page-title" text="Lamaran masuk" />
                                <Label fx:id="ringkasanLabel" style="-fx-text-fill: #667085; -fx-font-size: 13px;" text="0 lamaran masuk, 0 belum ditinjau" />
                            </children>
                        </VBox>
                        <Label fx:id="pesanLabel" managed="false" maxWidth="1.7976931348623157E308" text="Status lamaran sudah diubah." visible="false" wrapText="true" />
                        <HBox spacing="4.0" style="-fx-border-color: transparent transparent #EAECF0 transparent;">
                            <children>
                                <ToggleButton fx:id="semuaTab" mnemonicParsing="false" onAction="#handleFilter" selected="true" style="-fx-background-color: transparent; -fx-border-color: transparent transparent #1F4E8C transparent; -fx-border-width: 0 0 2 0; -fx-text-fill: #1F4E8C; -fx-font-size: 13px; -fx-font-weight: 600; -fx-padding: 6 12 10 12;" text="Semua">
                                    <toggleGroup>
                                        <ToggleGroup fx:id="statusTabGroup" />
                                    </toggleGroup>
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </ToggleButton>
                                <ToggleButton fx:id="diprosesTab" mnemonicParsing="false" onAction="#handleFilter" style="-fx-background-color: transparent; -fx-text-fill: #475467; -fx-font-size: 13px; -fx-padding: 6 12 10 12;" text="Diproses" toggleGroup="$statusTabGroup">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </ToggleButton>
                                <ToggleButton fx:id="ditinjauTab" mnemonicParsing="false" onAction="#handleFilter" style="-fx-background-color: transparent; -fx-text-fill: #475467; -fx-font-size: 13px; -fx-padding: 6 12 10 12;" text="Ditinjau" toggleGroup="$statusTabGroup">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </ToggleButton>
                                <ToggleButton fx:id="diterimaTab" mnemonicParsing="false" onAction="#handleFilter" style="-fx-background-color: transparent; -fx-text-fill: #475467; -fx-font-size: 13px; -fx-padding: 6 12 10 12;" text="Diterima" toggleGroup="$statusTabGroup">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </ToggleButton>
                                <ToggleButton fx:id="ditolakTab" mnemonicParsing="false" onAction="#handleFilter" style="-fx-background-color: transparent; -fx-text-fill: #475467; -fx-font-size: 13px; -fx-padding: 6 12 10 12;" text="Ditolak" toggleGroup="$statusTabGroup">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </ToggleButton>
                            </children>
                        </HBox>
                        <VBox style="-fx-background-color: white; -fx-border-color: #EAECF0; -fx-background-radius: 8; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                            <children>
                                <TableView fx:id="lamaranTable" fixedCellSize="46.0" styleClass="admin-table" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="pelamarColumn" prefWidth="150.0" text="Pelamar" />
                                        <TableColumn fx:id="posisiColumn" prefWidth="160.0" text="Posisi" />
                                        <TableColumn fx:id="perusahaanColumn" prefWidth="140.0" text="Perusahaan" />
                                        <TableColumn fx:id="tanggalColumn" prefWidth="95.0" text="Tanggal lamar" />
                                        <TableColumn fx:id="statusColumn" prefWidth="95.0" text="Status" />
                                        <TableColumn fx:id="aksiColumn" prefWidth="220.0" sortable="false" text="Aksi" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <placeholder>
                                        <Label style="-fx-text-fill: #667085; -fx-font-size: 13px;" text="Belum ada lamaran" />
                                    </placeholder>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>